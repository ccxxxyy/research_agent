# =============================================================================
# research-agent — example environment configuration.
#
# Copy to ``.env`` and fill the values you actually need. Every variable below
# has a sane default in ``src/research_agent/config.py``; this file documents
# the surface and is what the docker-compose ``app`` service mounts at runtime.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM providers
# -----------------------------------------------------------------------------
# The ModelRouter (``src/research_agent/llm/provider.py``) routes each agent
# call to one of three tiers (LIGHT / MEDIUM / HEAVY) via the LiteLLM SDK.
# In production you can set per-tier credentials independently; otherwise the
# top-level OPENAI_* / DEEPSEEK_* / DASHSCOPE_* keys are used as fallback.

OPENAI_API_KEY=sk-xxx
OPENAI_API_BASE=https://api.openai.com/v1

DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional per-tier overrides. Leave blank to fall back to OPENAI_* / DEEPSEEK_*.
LIGHT_MODEL=
LIGHT_API_KEY=
LIGHT_API_BASE=
MEDIUM_MODEL=
MEDIUM_API_KEY=
MEDIUM_API_BASE=
HEAVY_MODEL=
HEAVY_API_KEY=
HEAVY_API_BASE=

# -----------------------------------------------------------------------------
# Persistence
# -----------------------------------------------------------------------------
# PostgresSaver (LangGraph checkpointer) + Postgres-backed MemoryStore both
# consume POSTGRES_SYNC_URI. A TCP probe at startup skips Postgres when the
# host is down. When Postgres is skipped, checkpoints go to the SQLite file
# below (``CHECKPOINT_SQLITE_PATH``); leave it empty to use in-memory
# checkpoints only (no disk persistence for ``thread_id`` resume).

POSTGRES_URI=postgresql+asyncpg://research:research@localhost:5432/research_agent
POSTGRES_SYNC_URI=postgresql://research:research@localhost:5432/research_agent

# LangGraph AsyncSqliteSaver fallback when Postgres is unreachable (default in
# config.py). Set to empty to force MemorySaver only.
CHECKPOINT_SQLITE_PATH=data/langgraph_checkpoint.db

REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# RAG knowledge base
# -----------------------------------------------------------------------------
# The knowledge plane uses FAISS (``faiss-cpu``) for vector storage, one
# directory per collection under ``./data/knowledge_db``. There is no separate
# vector-store service to configure — FAISS files live on the app's volume.
#
# Disable the cross-encoder reranker on machines that cannot fit the
# bge-reranker-base weights (~280 MB), or where the model download is blocked.
KNOWLEDGE_RERANKER_ENABLED=1

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-agent
LANGCHAIN_TRACING_V2=false
LOG_LEVEL=INFO

# LangSmith evaluation suite (``python -m evals.eval_supervisor``).
# Requires LANGSMITH_API_KEY above + LANGCHAIN_TRACING_V2=true.
# The supervisor uses HEAVY tier LLM; the reply-quality judge uses LIGHT tier.
# Dataset is auto-uploaded from evals/datasets/supervisor_routing.json.

# -----------------------------------------------------------------------------
# FastAPI application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
CORS_ORIGINS=*
# Bearer token guarding write-side endpoints. Leave blank in dev to disable.
API_SECRET_KEY=
# Per-IP request budget enforced by the in-process RateLimitMiddleware.
RATE_LIMIT_RPM=30

# -----------------------------------------------------------------------------
# Reflection loop
# -----------------------------------------------------------------------------
# When enabled, the research supervisor's final synthesis goes through a
# critic + writer reflection subgraph (see docs/adr/0003-reflection-loop.md).
# Default OFF because reflection adds 1–5 extra LLM calls per request — flip
# to ``true`` for higher answer quality at the cost of latency / spend.
REFLECTION_ENABLED=false
# Critic score in [0.0, 1.0] at or above which the loop terminates without
# triggering a rewrite. 0.85 is the boundary between the critic's "ship as-is"
# and "ship after a light rewrite" calibration bands.
REFLECTION_PASS_THRESHOLD=0.85
# Hard cap on writer rewrites. Worst-case LLM budget per request is
# (max_iterations + 1) critic calls plus max_iterations writer calls.
REFLECTION_MAX_ITERATIONS=2

# -----------------------------------------------------------------------------
# SSE (research supervisor stream)
# -----------------------------------------------------------------------------
# Seconds between idle ``phase=heartbeat`` DATA frames on
# ``POST /api/supervisor/research/stream`` — keeps proxies from closing idle
# long-running streams. Zero disables heartbeat.
SSE_RESEARCH_HEARTBEAT_SECONDS=15
