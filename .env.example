# =============================================================================
# research-agent — example environment configuration.
#
# Copy to ``.env`` and fill the values you actually need. Every variable below
# has a sane default in ``src/research_agent/config.py``; this file documents
# the surface and is what the docker-compose ``app`` service mounts at runtime.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM providers
# -----------------------------------------------------------------------------
# The ModelRouter (``src/research_agent/llm/provider.py``) routes each agent
# call to one of three tiers (LIGHT / MEDIUM / HEAVY) via the LiteLLM SDK.
# In production you can set per-tier credentials independently; otherwise the
# top-level OPENAI_* / DEEPSEEK_* / DASHSCOPE_* keys are used as fallback.

OPENAI_API_KEY=sk-xxx
OPENAI_API_BASE=https://api.openai.com/v1

DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional per-tier overrides. Leave blank to fall back to OPENAI_* / DEEPSEEK_*.
LIGHT_MODEL=
LIGHT_API_KEY=
LIGHT_API_BASE=
MEDIUM_MODEL=
MEDIUM_API_KEY=
MEDIUM_API_BASE=
HEAVY_MODEL=
HEAVY_API_KEY=
HEAVY_API_BASE=

# -----------------------------------------------------------------------------
# Persistence
# -----------------------------------------------------------------------------
# PostgresSaver (LangGraph checkpointer) + long-term MemoryStore both consume
# POSTGRES_SYNC_URI. The async URI is reserved for future SQLAlchemy needs.
# A TCP probe at startup gracefully falls back to SQLite if Postgres is down —
# you can run the whole app with neither variable set, in which case
# checkpointing is in-memory only.

POSTGRES_URI=postgresql+asyncpg://research:research@localhost:5432/research_agent
POSTGRES_SYNC_URI=postgresql://research:research@localhost:5432/research_agent

REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# RAG knowledge base
# -----------------------------------------------------------------------------
# The knowledge plane uses FAISS (``faiss-cpu``) for vector storage, one
# directory per collection under ``./data/knowledge_db``. There is no separate
# vector-store service to configure — FAISS files live on the app's volume.
#
# Disable the cross-encoder reranker on machines that cannot fit the
# bge-reranker-base weights (~280 MB), or where the model download is blocked.
KNOWLEDGE_RERANKER_ENABLED=1

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-agent
LANGCHAIN_TRACING_V2=false
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# FastAPI application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
CORS_ORIGINS=*
# Bearer token guarding write-side endpoints. Leave blank in dev to disable.
API_SECRET_KEY=
# Per-IP request budget enforced by the in-process RateLimitMiddleware.
RATE_LIMIT_RPM=30
