# =============================================================================
# research-agent — 环境配置示例。
#
# 复制为 ``.env`` 并填入实际需要的值。
#下方每个变量都有``src/research_agent/config.py`` 中的合理默认值；此文件仅用于记录配置表面，也是 docker-compose 中 ``app`` 服务在运行时挂载的配置。
# =============================================================================

# -----------------------------------------------------------------------------
# LLM 提供商
# -----------------------------------------------------------------------------
# ModelRouter（``src/research_agent/llm/provider.py``）通过 langchain-openai 的 ChatOpenAI 将每个 Agent 调用路由到三个层级之一（LIGHT / MEDIUM / HEAVY）。
# 每层可配独立的 model/api_key/api_base；未配置时回退到顶层的 OPENAI_* / DEEPSEEK_* / DASHSCOPE_* 密钥。

OPENAI_API_KEY=sk-xxx
OPENAI_API_BASE=https://api.openai.com/v1

DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选的按层级覆盖。留空则回退到 OPENAI_* / DEEPSEEK_*。
LIGHT_MODEL=
LIGHT_API_KEY=
LIGHT_API_BASE=
MEDIUM_MODEL=
MEDIUM_API_KEY=
MEDIUM_API_BASE=
HEAVY_MODEL=
HEAVY_API_KEY=
HEAVY_API_BASE=

# 单次 ChatOpenAI HTTP 补全请求的最大等待时间（秒）。防止 worker 挂起。
REQUEST_TIMEOUT_SECONDS=180

# -----------------------------------------------------------------------------
# 持久化
# -----------------------------------------------------------------------------
# PostgresSaver（LangGraph 检查点器）和基于 Postgres 的 MemoryStore 都使用 POSTGRES_SYNC_URI。
# 启动时的 TCP 探测会在主机不可达时跳过 Postgres。
# 跳过时，检查点写入下方的 SQLite 文件（``CHECKPOINT_SQLITE_PATH``）；
# 留空则仅使用内存检查点（无法通过 ``thread_id`` 恢复对话）。

POSTGRES_URI=postgresql+asyncpg://research:research@localhost:5432/research_agent
POSTGRES_SYNC_URI=postgresql://research:research@localhost:5432/research_agent

REDIS_URL=redis://localhost:6379/0

# MCP 工具原始结果缓存（不是 LLM 回答）。按数据类型分层 TTL：
# 实时行情 ~20s / 新闻 ~2min / 资金流·龙虎榜 ~5min / 日K·净值 ~1h / 概况·评级 ~6h。
# 错误响应不入缓存。默认进程内内存；设 TOOL_CACHE_BACKEND=redis 可跨 worker 共享。
TOOL_CACHE_ENABLED=true
TOOL_CACHE_BACKEND=memory

# 静态知识语义缓存（术语/口径/FAQ/模板/宏观解读/历史事件定义）。
# 用 FAISS + bge-small-zh 做语义命中，带 cache_domain/version/locale 维度过滤。
# 含股票代码或「最新行情」类动态问题会自动跳过，不短路 research graph。
# 索引落盘：./data/semantic_cache/static_knowledge/
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.82

# 当 Postgres 不可达时，LangGraph AsyncSqliteSaver 的回退路径，
# 用于线程检查点。留空则仅使用内存检查点。
CHECKPOINT_SQLITE_PATH=data/langgraph_checkpoint.db

# 应用启动时的 MCP 工具发现超时；按服务器计上限。超时则跳过该专家。
MCP_TOOL_DISCOVERY_TIMEOUT=30

# 当 Postgres 不可达时，LangGraph AsyncSqliteStore 的回退路径，
# 用于长期记忆（用户偏好 + 研究历史）。留空则仅使用
# InMemoryStore（重启后丢失）。
MEMORY_STORE_SQLITE_PATH=data/langgraph_memory_store.db

# -----------------------------------------------------------------------------
# RAG 知识库
# -----------------------------------------------------------------------------
# 知识平面使用 FAISS（``faiss-cpu``）做向量存储，每个集合对应 ``./data/knowledge_db`` 下的一个目录。无需单独配置向量存储服务 — FAISS 文件存放在应用的数据卷上。
#
# 在无法容纳 bge-reranker-base 权重（约 280 MB）或模型下载被阻断的机器上，
# 可禁用 cross-encoder 重排序器。
KNOWLEDGE_RERANKER_ENABLED=1

# -----------------------------------------------------------------------------
# 可观测性
# -----------------------------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-agent
LANGCHAIN_TRACING_V2=false
LOG_LEVEL=INFO
# 滚动文件日志；留空则仅输出到 stderr。
LOG_FILE_PATH=logs/research_agent.log

# LangSmith 评估套件（``python -m evals.eval_supervisor``）。
# 需要上方的 LANGSMITH_API_KEY + LANGCHAIN_TRACING_V2=true。
# supervisor 使用 HEAVY 层 LLM；回答质量评审使用 LIGHT 层。
# 数据集从 evals/datasets/supervisor_routing.json 自动上传。

# -----------------------------------------------------------------------------
# Finnhub（可选：新闻第二源 + 报价第二源）
# -----------------------------------------------------------------------------
# 同一 Key 启用：company-news（新闻）与 /quote（行情，Yahoo Chart 失败后）。
# 留空则新闻仅 Yahoo，报价跳过 Finnhub（Chart → 东财 → yfinance），不报错。
# 申请：https://finnhub.io/
FINNHUB_API_KEY=

# -----------------------------------------------------------------------------
# FastAPI 应用
# -----------------------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
CORS_ORIGINS=*
# 保护写操作端点的 Bearer Token。开发环境留空即可禁用。
API_SECRET_KEY=
# 由进程内 RateLimitMiddleware 执行的单 IP 请求限额。
RATE_LIMIT_RPM=30
# 非 SSE HTTP 请求的最大响应时间（秒）。设为 0 则禁用。SSE 不受此限。
HTTP_REQUEST_TIMEOUT_SECONDS=0

# -----------------------------------------------------------------------------
# 反思循环
# -----------------------------------------------------------------------------
# 启用后，研究 supervisor 的最终综合报告将经过批评者 + 写作者反思子图（见 docs/adr/0003-reflection-loop.md）。
# 默认关闭，因为反思每次请求会增加 1-5 次额外 LLM 调用 — 设为 ``true`` 可提升回答质量，但代价是延迟和费用增加。
REFLECTION_ENABLED=false
# 批评者分数 [0.0, 1.0]，达到或超过此阈值时循环终止，不触发改写。
# 0.85 是批评者"直接发布"与"轻度改写后发布"校准区间的边界。
REFLECTION_PASS_THRESHOLD=0.85
# 写作者改写次数的硬上限。每次请求最坏情况下的 LLM 预算为
# (max_iterations + 1) 次批评 + max_iterations 次改写。
REFLECTION_MAX_ITERATIONS=2

# -----------------------------------------------------------------------------
# SSE（研究 supervisor 流式传输）
# -----------------------------------------------------------------------------
# ``POST /api/supervisor/research/stream`` 上空闲时发送 ``phase=heartbeat`` DATA 帧的间隔秒数 — 防止代理/网关关闭长时间空闲的流式连接。设为 0 禁用心跳。
SSE_RESEARCH_HEARTBEAT_SECONDS=15
