# === LLM API Keys ===
OPENAI_API_KEY=sk-xxx
OPENAI_API_BASE=https://api.openai.com/v1

DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# === Database ===
POSTGRES_URI=postgresql+asyncpg://research:research@localhost:5432/research_agent
POSTGRES_SYNC_URI=postgresql://research:research@localhost:5432/research_agent

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === ChromaDB ===
CHROMA_HOST=localhost
CHROMA_PORT=8000

# === LangSmith Tracing (optional) ===
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-agent
LANGCHAIN_TRACING_V2=false

# === Application ===
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO
